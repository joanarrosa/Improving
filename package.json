{
  "name": "outsystems-perf-analyzer",
  "version": "0.1.0",
  "description": "Local static analyzer for OutSystems .NET code exports (O11/ODC) - finds N+1 queries, duplicate integration calls, missing timeout/retry, unbounded fetches and cacheable repeated actions.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^4.21.2",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
